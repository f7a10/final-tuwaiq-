# External providers — add real values only to .env (never commit it)
OPENROUTER_API_KEY=
ROBOFLOW_API_KEY=

# Floor-plan detector. "local" never sends the plan to Roboflow.
FLOOR_PLAN_DETECTOR=local
LOCAL_FLOORPLAN_MAX_DIMENSION=512
# Optional override. Relative paths are resolved from the process working directory.
# LOCAL_FLOORPLAN_MODEL_PATH=models/cubicasa5k-structure.safetensors

# OpenRouter role routing
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_PLANNING_MODEL=openai/gpt-4.1-mini
OPENROUTER_ASSISTANT_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1-mini

# Generate a long random value before deployment
JWT_SECRET_KEY=
